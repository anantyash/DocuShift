{
  "name": "docushift",
  "version": "1.0.0",
  "description": "Production-ready high-fidelity Word to PDF Converter preserving Word styles, fonts, and layouts",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:exe": "npx @yao-pkg/pkg -t node18-win-x64 --out-path dist server.js"
  },
  "keywords": ["word", "docx", "pdf", "converter", "com", "office", "batch-converter"],
  "author": "Yash",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "uuid": "^11.0.5"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "scripts/**/*"
    ]
  }
}
